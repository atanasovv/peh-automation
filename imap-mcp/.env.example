# Set these values in the Arcane project environment or in a local .env.
MAIL_MCP_DOMAIN=mcp.lexiplay.app
MAIL_MCP_IMAGE=ghcr.io/atanasovv/peh-mail-mcp:latest
# Generate a separate random token, for example with: openssl rand -hex 32
MCP_AUTH_TOKEN=
IMAP_SERVER=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Exact IMAP folder name, optional when the server advertises Drafts.
EMAIL_DRAFTS_FOLDER=
